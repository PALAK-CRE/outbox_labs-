# ==========================================
# REACHINBOX BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server & Network
PORT=5000
NODE_ENV=production
# Set this to your Vercel URL (e.g. https://your-project.vercel.app)
FRONTEND_URL=https://your-frontend.vercel.app

# Database Configuration (PostgreSQL)
# Render Internal/External Database URL, Supabase, Neon, or local Postgres
DATABASE_URL="postgresql://user:password@hostname:5432/reachinbox_scheduler?schema=public"

# Redis Configuration (BullMQ + Rate Limiting)
# On Render / Upstash / Redis Cloud, provide REDIS_URL (e.g. redis://red-xxx:6379 or rediss://default:xxx@xxx.upstash.io:6379)
REDIS_URL=
# Or use host/port for local development:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch Configuration (Optional - falls back gracefully to Database Full-Text Search if unreachable)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Concurrency & Rate Limiting
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# JWT Auth Secret
JWT_SECRET=super-secret-reachinbox-jwt-key-2025

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Slack OAuth & Webhook Credentials (Optional)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=https://your-backend.onrender.com/api/slack/oauth_redirect
SLACK_TEST_WEBHOOK_URL=

# SMTP Configuration (Optional - Ethereal test account is auto-provisioned if left blank)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="ReachInbox Outreach"
ETHEREAL_USER=
ETHEREAL_PASS=
