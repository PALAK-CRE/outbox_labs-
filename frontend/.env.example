# ==========================================
# REACHINBOX FRONTEND ENVIRONMENT VARIABLES
# ==========================================

# Backend API Endpoint on Render (e.g. https://reachinbox-scheduler-backend.onrender.com/api)
VITE_API_URL=https://your-backend.onrender.com/api

# BullMQ Queue Monitor URL on Render (e.g. https://reachinbox-scheduler-backend.onrender.com/admin/queues)
VITE_BULL_BOARD_URL=https://your-backend.onrender.com/admin/queues

# Google OAuth Client ID (Optional)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
